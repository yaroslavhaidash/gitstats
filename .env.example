# Postgres over Neon's HTTP driver (lib uses @neondatabase/serverless, so it must be a Neon URL).
# A free Neon project or a branch of one; `vercel env pull` fills these when the Vercel integration is connected.
DATABASE_URL=
DATABASE_URL_UNPOOLED=  # direct (non-pooled) URL; drizzle-kit migrations prefer it, falls back to DATABASE_URL

# Auth.js
AUTH_SECRET=            # openssl rand -base64 32
AUTH_GITHUB_ID=         # GitHub OAuth App client id; callback <APP_URL>/api/auth/callback/github
AUTH_GITHUB_SECRET=     # GitHub OAuth App client secret

# Snapshot job
GITHUB_TOKEN=           # classic PAT, no scopes (public read only)
CRON_SECRET=            # openssl rand -hex 32; Vercel Cron sends it as a bearer token

# Encrypts user-supplied fine-grained PATs at rest
TOKEN_ENCRYPTION_KEY=   # openssl rand -base64 32

# Signs share-card URLs (/s/<token>); changing it invalidates every card already shared
SHARE_SECRET=           # openssl rand -base64 32

# Origin used in invite links, e.g. http://localhost:3000 or https://your.domain
NEXT_PUBLIC_APP_URL=

# Optional: comma-separated numeric GitHub account ids allowed to open /admin (https://api.github.com/users/<login> → id).
# Ids, not logins: a renamed login can be registered by someone else. Unset means nobody (404 for all)
ADMIN_GITHUB_IDS=

# Optional: POSTed a one-line JSON summary when two snapshot runs in a row have errors
ALERT_WEBHOOK_URL=      # any URL that accepts JSON (a Slack or Discord incoming webhook works)
